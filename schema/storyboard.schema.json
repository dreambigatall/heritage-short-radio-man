{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Every stage reads this file; nothing about a shot lives in code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "logline", "language", "audience", "intent", "style", "models", "characters", "voice", "music", "output", "end_card", "shots"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "logline": { "type": "string", "minLength": 1, "description": "One sentence that sums up the story." },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$", "description": "BCP-47 code of the narration language, e.g. am, om, ti, so, en." },
    "audience": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1, "description": "What the audience should feel or understand at the end." },

    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_block"],
      "properties": {
        "style_block": { "type": "string", "minLength": 1, "description": "Appended to every image prompt so the look never drifts." },
        "negative": { "type": "string", "description": "Things to avoid, for models that accept a negative prompt." }
      }
    },

    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "image_steps", "use_reference_images"],
      "properties": {
        "image": { "type": "string", "description": "Cloudflare Workers AI model id for keyframes." },
        "image_steps": { "type": "integer", "minimum": 1, "maximum": 50 },
        "image_size": { "type": "integer", "enum": [768, 1024], "default": 1024 },
        "use_reference_images": { "type": "boolean", "description": "Send the character reference sheet with each keyframe (FLUX.2 only)." },
        "send_seed": { "type": "boolean", "default": true, "description": "Set false if the provider rejects the seed field." },
        "script": { "type": "string", "description": "Gemini text model used to draft the storyboard." }
      }
    },

    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "seed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string" },
          "description": { "type": "string", "minLength": 1, "description": "Fixed appearance text, inserted verbatim wherever the character appears." },
          "seed": { "type": "integer", "minimum": 0 },
          "consent_ref": { "type": "string", "description": "Pointer to the consent entry in ETHICS.md when this is a real person." }
        }
      }
    },

    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "voice_name", "style_instruction"],
      "properties": {
        "model": { "type": "string" },
        "voice_name": { "type": "string" },
        "style_instruction": { "type": "string", "description": "Plain-language delivery note, e.g. 'Read slowly and warmly, like telling a story to a grandchild.'" }
      }
    },

    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cues", "chosen"],
      "properties": {
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "caption", "bpm", "duration_s", "instrumental", "purpose"],
            "properties": {
              "id": { "type": "string" },
              "purpose": { "type": "string", "description": "Spotting note: what this cue does emotionally." },
              "caption": { "type": "string", "description": "ACE-Step caption: style, mood, instruments, texture. No tempo or key here." },
              "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
              "key": { "type": "string" },
              "duration_s": { "type": "number", "minimum": 10, "maximum": 240 },
              "instrumental": { "type": "boolean" },
              "seeds": { "type": "array", "items": { "type": "integer" }, "description": "One candidate per seed." }
            }
          }
        },
        "chosen": { "type": ["string", "null"], "description": "Filename (in outputs/music/candidates) of the chosen candidate, or null for the placeholder." },
        "chosen_reason": { "type": "string" },
        "music_gain_db": { "type": "number", "default": -6 }
      }
    },

    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "quality"],
      "properties": {
        "fps": { "type": "integer", "enum": [24, 25, 30] },
        "quality": { "type": "string", "enum": ["draft", "final"], "description": "draft = 720p, final = 1080p." },
        "narration_pad_s": { "type": "number", "minimum": 0, "maximum": 3, "default": 0.6 },
        "narration_lead_s": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.3 }
      }
    },

    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines", "duration_s"],
      "properties": {
        "lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "duration_s": { "type": "number", "minimum": 2, "maximum": 6 }
      }
    },

    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "shot_size", "duration_s", "image_prompt", "seed", "camera", "video", "narration", "subtitle_en"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]{2}$" },
          "reason": { "type": "string", "minLength": 5, "description": "Why this shot exists, in one sentence." },
          "shot_size": { "type": "string", "enum": ["extreme_wide", "wide", "medium", "medium_close_up", "close_up", "extreme_close_up", "insert"] },
          "duration_s": { "type": "number", "minimum": 2, "maximum": 15, "description": "Minimum on-screen time; the narration can make it longer." },
          "characters": { "type": "array", "items": { "type": "string" } },
          "image_prompt": { "type": "string", "minLength": 10, "description": "What is in the frame. Character descriptions and the style block are added automatically." },
          "seed": { "type": "integer", "minimum": 0 },
          "motion_prompt": { "type": "string", "description": "Image-to-video prompt: motion and camera only." },
          "camera": { "type": "string", "enum": ["static", "push_in", "pull_out", "pan_left", "pan_right", "tilt_up", "tilt_down"], "description": "Ken Burns move used when no generated clip exists." },
          "video": { "type": "string", "enum": ["kenburns", "wan"], "description": "wan = send to the Kaggle Wan 2.2 job; falls back to kenburns until the clip exists." },
          "narration": { "type": "string", "description": "Narration line in the film's language. May be empty for a silent shot." },
          "subtitle_en": { "type": "string", "description": "English subtitle for this line." },
          "music_cue": { "type": "string" },
          "use_reference": { "type": "boolean", "default": true, "description": "false = describe the character in text only, for shots where the reference image overrides the pose or props (EXPERIMENTS E5)." }
        }
      }
    }
  }
}
